@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://interspock.github.io/isla-poly800>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    lv2:binary <isla-poly800.so> ;
    rdfs:seeAlso <isla-poly800.ttl> , <state.ttl> .

<https://interspock.github.io/isla-poly800#preset-init-whole>
    a pset:Preset ;
    lv2:appliesTo <https://interspock.github.io/isla-poly800> ;
    rdfs:seeAlso <presets.ttl> .

<https://interspock.github.io/isla-poly800#preset-double-fifth>
    a pset:Preset ;
    lv2:appliesTo <https://interspock.github.io/isla-poly800> ;
    rdfs:seeAlso <presets.ttl> .
