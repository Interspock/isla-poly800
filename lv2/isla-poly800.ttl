@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://interspock.github.io/isla-poly800>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "ISLA Poly-800 (M0 Smoke Test)" ;
    doap:license <https://spdx.org/licenses/GPL-3.0-or-later.html> ;
    rdfs:comment "Headless LV2 smoke-test instrument. This milestone validates MIDI, audio and generic host controls; it is not yet a Poly-800 emulation." ;
    lv2:requiredFeature urid:map ;
    lv2:port
        [
            a lv2:InputPort , atom:AtomPort ;
            lv2:index 0 ;
            lv2:symbol "midi_in" ;
            lv2:name "MIDI In" ;
            atom:bufferType atom:Sequence ;
            atom:supports midi:MidiEvent
        ] ,
        [
            a lv2:OutputPort , lv2:AudioPort ;
            lv2:index 1 ;
            lv2:symbol "audio_l" ;
            lv2:name "Audio Left"
        ] ,
        [
            a lv2:OutputPort , lv2:AudioPort ;
            lv2:index 2 ;
            lv2:symbol "audio_r" ;
            lv2:name "Audio Right"
        ] ,
        [
            a lv2:InputPort , lv2:ControlPort ;
            lv2:index 3 ;
            lv2:symbol "gain" ;
            lv2:name "Gain" ;
            lv2:default 0.20 ;
            lv2:minimum 0.0 ;
            lv2:maximum 1.0
        ] ,
        [
            a lv2:InputPort , lv2:ControlPort ;
            lv2:index 4 ;
            lv2:symbol "tune" ;
            lv2:name "Fine Tune (cents)" ;
            lv2:default 0.0 ;
            lv2:minimum -100.0 ;
            lv2:maximum 100.0
        ] .
